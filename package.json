{
	"name": "deck",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check",
		"preview": "vite preview",
		"format": "biome check --write",
		"prepare": "lefthook install && pnpm i18n",
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"@react-three/postprocessing": "^3.1.1",
		"postprocessing": "^6.39.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@inlang/paraglide-js": "^2.25.4",
		"@react-three/test-renderer": "^9.1.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.1.0",
		"lefthook": "2.1.14",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.30.3"
}
